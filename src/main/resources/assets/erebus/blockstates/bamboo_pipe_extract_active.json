{
   "multipart":[
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_centre"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_extract_on",
            "x":270
         },
         "when":{
            "facing":"up"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_extract_on",
            "x":90,
            "y":180
         },
         "when":{
            "facing":"down"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_extract_on"
         },
         "when":{
            "facing":"north"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_extract_on",
            "y":90
         },
         "when":{
            "facing":"east"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_extract_on",
            "y":180
         },
         "when":{
            "facing":"south"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_extract_on",
            "y":270
         },
         "when":{
            "facing":"west"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_join",
            "x":90
         },
         "when":{
            "connected_down":"true"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_join",
            "y":90
         },
         "when":{
            "connected_east":"true"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_join"
         },
         "when":{
            "connected_north":"true"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_join",
            "x":180
         },
         "when":{
            "connected_south":"true"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_join",
            "x":270
         },
         "when":{
            "connected_up":"true"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_join",
            "y":270
         },
         "when":{
            "connected_west":"true"
         }
      }
   ]
}

