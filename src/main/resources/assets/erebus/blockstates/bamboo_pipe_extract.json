{
   "multipart":[
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_centre"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_extract_off",
            "x":270
         },
         "when":{
            "facing":"up",
            "active":"false"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_extract_off",
            "x":90,
            "y":180
         },
         "when":{
            "facing":"down",
            "active":"false"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_extract_off"
         },
         "when":{
            "facing":"north",
            "active":"false"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_extract_off",
            "y":90
         },
         "when":{
            "facing":"east",
            "active":"false"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_extract_off",
            "y":180
         },
         "when":{
            "facing":"south",
            "active":"false"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_extract_off",
            "y":270
         },
         "when":{
            "facing":"west",
            "active":"false"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_extract_on",
            "x":270
         },
         "when":{
            "facing":"up",
            "active":"true"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_extract_on",
            "x":90,
            "y":180
         },
         "when":{
            "facing":"down",
            "active":"true"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_extract_on"
         },
         "when":{
            "facing":"north",
            "active":"true"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_extract_on",
            "y":90
         },
         "when":{
            "facing":"east",
            "active":"true"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_extract_on",
            "y":180
         },
         "when":{
            "facing":"south",
            "active":"true"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_extract_on",
            "y":270
         },
         "when":{
            "facing":"west",
            "active":"true"
         }
      }, 
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_join",
            "x":90
         },
         "when":{
            "connected_down":"true"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_join",
            "y":90
         },
         "when":{
            "connected_east":"true"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_join"
         },
         "when":{
            "connected_north":"true"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_join",
            "x":180
         },
         "when":{
            "connected_south":"true"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_join",
            "x":270
         },
         "when":{
            "connected_up":"true"
         }
      },
      {
         "apply":{
            "model":"erebus:block/bamboo_pipe_join",
            "y":270
         },
         "when":{
            "connected_west":"true"
         }
      }
   ]
}

